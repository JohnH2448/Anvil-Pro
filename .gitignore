# Keep the repository source-first. New top-level scratch files are ignored
# unless explicitly allowed here.
/*
!/.gitignore
!/LICENSE
!/README.md
!/ARCHITECTURE.md
!/Docs/
!/Core/
!/Synthesis/README.md
!/Synthesis/Scripts/
!/Synthesis/Scripts/**
!/Synthesis/Reports/
!/Synthesis/Reports/**
!/Test/
!/Software/

# Python/test byproducts.
__pycache__/
*.py[cod]
.pytest_cache/
Test/Automation/*.log
Test/Automation/hex_results.log

# Software build outputs.
/Software/program.elf
/Software/program.map
/Software/program.raw.hex
/Software/program.text.bin
/Software/program.analysis.map
/Software/program.analysis.elf
/Software/generated/

# FPGA/tool outputs.
/.Xil/
/build/
/Synthesis/Checkpoints/
/Synthesis/Logs/
/Synthesis/.Xil/
/Synthesis/clockInfo.txt
/Synthesis/dfx_runtime.txt
/Synthesis/tight_setup_hold_pins.txt
/Verilator/
/vivado*.jou
/vivado*.log
*.dcp
*.rpt
!/Synthesis/Reports/*.rpt
!/Synthesis/Reports/*.csv
*.wdb
*.vcd
*.fst

# Local scratch outputs.
/tmp/
/output/
/node_modules/
/riscof/
/clockInfo.txt
/dfx_runtime.txt
/tight_setup_hold_pins.txt
